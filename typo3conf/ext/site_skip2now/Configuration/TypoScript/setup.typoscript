page = PAGE

page {
    typeNum = 0

    10 = FLUIDTEMPLATE
    10 {
        templateName = Default

        templateRootPaths {
            10 = EXT:site_skip2now/Resources/Private/Templates/Page/
        }

        partialRootPaths {
            10 = EXT:site_skip2now/Resources/Private/Partials/
        }

        layoutRootPaths {
            10 = EXT:site_skip2now/Resources/Private/Layouts/
        }

        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            10 {
                levels = 2
                as = mainNavigation
            }
        }
    }

    includeCSS {
        skip2now = EXT:site_skip2now/Resources/Public/Css/main.css
    }

    meta {
        viewport = width=device-width, initial-scale=1
    }
}