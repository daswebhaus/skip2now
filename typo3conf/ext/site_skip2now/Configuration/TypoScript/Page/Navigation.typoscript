
# =============================================================================
# SITE SKIP2NOW | Main Navigation
# =============================================================================
#
# File:        Configuration/TypoScript/Page/Navigation.typoscript
# Description: Main navigation DataProcessor and CSS configuration
# Status:      MIGRATED
#
# =============================================================================

page {
    10 {
        dataProcessing {
            2010 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            2010 {
                levels = 2
                as = mainNavigation
            }
        }
    }

    includeCSS {
        mainNavigation = EXT:site_skip2now/Resources/Public/Css/Components/MainNavigation.css
    }
}
