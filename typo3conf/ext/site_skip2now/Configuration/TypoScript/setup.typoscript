
# =============================================================================
# SITE SKIP2NOW | TYPO3 TypoScript Setup
# =============================================================================
#
# File:        Configuration/TypoScript/setup.typoscript
# Description: Central entry point for all project TypoScript configurations
# Status:      MIGRATED
#
# Architecture:
#   All TypoScript configurations are organized into functional modules.
#   This file only manages imports and their loading order.
#
#   Page/            Page setup, Fluid templates and global DataProcessors
#   Navigation/      Independent navigation components, such as breadcrumbs and footer navigation
#   ContentElements/ Custom content elements
#   Extensions/      Extension-specific configurations
#   Integrations/    External services and integrations
#   Features/        Project-specific features
#
# Guidelines:
#   - Use explicit @import statements with complete EXT: paths.
#   - Keep functional configurations in their respective modules.
#   - Maintain the correct import order to avoid unintended overrides.
#   - Add new modules only when required.
#
# =============================================================================


# -----------------------------------------------------------------------------
# PAGE | Base configuration, Fluid templates and navigation
# -----------------------------------------------------------------------------

@import 'EXT:site_skip2now/Configuration/TypoScript/Page/Page.typoscript'
@import 'EXT:site_skip2now/Configuration/TypoScript/Page/FluidTemplate.typoscript'
@import 'EXT:site_skip2now/Configuration/TypoScript/Page/Navigation.typoscript'
