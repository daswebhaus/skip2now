
# File: Configuration/TypoScript/Page/Page.typoscript
# Description: Main PAGE object, viewport and global CSS
# Status: CREATED

page = PAGE

page {
    typeNum = 0

    meta {
        viewport = width=device-width, initial-scale=1
    }

    # Favicon
    shortcutIcon = EXT:site_skip2now/Resources/Public/Icons/favicon.png

    includeCSS {
        # Design Variables
        colors = EXT:site_skip2now/Resources/Public/Css/Variables/Colors.css

        # Global Base Styles
        global = EXT:site_skip2now/Resources/Public/Css/Base/Global.css

        # Page Layout
        layout = EXT:site_skip2now/Resources/Public/Css/Page/Layout.css
        header = EXT:site_skip2now/Resources/Public/Css/Page/Header.css
        footer = EXT:site_skip2now/Resources/Public/Css/Page/Footer.css
    }
}
